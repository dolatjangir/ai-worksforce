generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
}

model AdminUser {
  id Int @id @default(autoincrement())

  fullName String @db.VarChar(120)

  email String @unique @db.VarChar(254)

  passwordHash String? @db.VarChar(255)

  role AdminRole @default(ADMIN)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Assessment {
  id Int @id @default(autoincrement())

  fullName    String @db.VarChar(120)
  email       String @db.VarChar(254)
  company     String @db.VarChar(160)
  phone       String @db.VarChar(30)
  industry    String @db.VarChar(100)
  companySize String @db.VarChar(50)
  goals       String @db.Text

  status String @default("NEW") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([company])
  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id Int @id @default(autoincrement())

  fullName String  @db.VarChar(120)
  email    String  @db.VarChar(254)
  company  String  @db.VarChar(160)
  phone    String? @db.VarChar(30)
  service  String  @db.VarChar(100)
  message  String  @db.Text

  status String @default("NEW") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([service])
  @@index([status])
  @@index([createdAt])
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.LongText
  featuredImg String?
  pageName    String
  tags        String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([pageName])
}

model SeoEntry {
  id                 String   @id @default(uuid())
  pageName           String
  slug               String   @unique
  url                String   @unique
  metaTitle          String
  metaDescription    String   @db.VarChar(1000)
  keywords           String   @db.VarChar(1000) // Stored as JSON string array
  canonicalUrl       String?  @db.VarChar(500)
  ogTitle            String?  @db.VarChar(255)
  ogDescription      String?  @db.VarChar(1000)
  ogImage            String?  @db.VarChar(500)
  twitterTitle       String?  @db.VarChar(255)
  twitterDescription String?  @db.VarChar(1000)
  twitterImage       String?  @db.VarChar(500)
  seoScore           Int      @default(0)
  status             Status   @default(draft)
  indexable          Boolean  @default(true)
  lastModified       DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@index([status])
  @@index([seoScore])
  @@map("seo_entries")
}

enum Status {
  published
  draft
}

model JobApplication {
  id String @id @default(cuid())

  // Candidate information
  name              String  @db.VarChar(160)
  email             String  @db.VarChar(191)
  phone             String  @db.VarChar(30)
  candidateLocation String  @db.VarChar(120)
  linkedin          String? @db.VarChar(500)
  portfolio         String? @db.VarChar(500)
  motivation        String  @db.Text
  consent           Boolean @default(false)

  // Job information
  jobSlug     String @db.VarChar(191)
  jobTitle    String @db.VarChar(191)
  department  String @db.VarChar(191)
  jobLocation String @db.VarChar(191)
  jobType     String @db.VarChar(100)

  // Google Drive resume information
  resumeName     String  @db.VarChar(255)
  resumeDriveId  String  @db.VarChar(255)
  resumeViewLink String? @db.Text
  resumeMimeType String  @db.VarChar(100)
  resumeSize     Int

  // Application
  status    String   @default("NEW") @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([jobSlug])
  @@index([status])
  @@index([createdAt])
  @@index([resumeDriveId])
}
